# Example production env values for Vite (copy and edit before use)
# IMPORTANT: replace `api.example.com` with your real API domain.

# Public API base the frontend will call (include /api if your backend uses it)
VITE_API_URL=https://api.example.com/api

# WebSocket base (must be secure wss:// in production)
VITE_WS_URL=wss://api.example.com/ws

# Notes:
# - These variables are embedded into the client bundle at build time.
# - Do NOT store secrets (API keys, tokens, passwords) in VITE_ variables.
# - If you only set VITE_API_URL, the app will auto-derive WS base (https -> wss).
# - After adding/changing env vars in Vercel, trigger a redeploy so values are picked up.

# Quick ngrok example (for testing only):
# 1) Run: `ngrok http 8000`
# 2) Set:
#    VITE_API_URL=https://<ngrok-id>.ngrok.io/api
#    VITE_WS_URL=wss://<ngrok-id>.ngrok.io/ws
# Note: ngrok websocket support may depend on your plan; use only for testing.
